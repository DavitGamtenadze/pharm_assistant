# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_API_KEY=
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
APP_MAX_UPLOAD_MB=20
APP_UPLOAD_RATE_LIMIT=10
APP_QUESTION_RATE_LIMIT=20

# Retrieval
APP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
APP_CHUNK_SIZE_WORDS=240
APP_CHUNK_OVERLAP_WORDS=30
APP_TOP_K=8
APP_MAX_CONTEXT_CHARS=16000

# OpenAI generation
OPENAI_API_KEY=
APP_OPENAI_MODEL=gpt-5-mini
APP_OPENAI_TIMEOUT_SECONDS=120

# Optional Langfuse tracing (content is redacted unless capture is enabled)
APP_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
APP_LANGFUSE_CAPTURE_CONTENT=false
